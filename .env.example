# The application defaults to DEMO and refuses LIVE unless both guards are set.
TRADING_MODE=demo
LIVE_TRADING_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
DATABASE_URL=postgresql+psycopg://forex:forex@postgres:5432/forexbot
REDIS_URL=redis://redis:6379/0
API_SECRET_KEY=replace-with-a-long-random-secret
API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:3000
SYMBOLS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURJPY,GBPJPY,EURGBP
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
MAX_DRAWDOWN_PCT=10.0
# Hard limits. The dollar ceilings are absolute, not percentages of equity: MAX_BOT_CAPITAL_USD is
# the allocation this bot may use (never the account's equity), MAX_LOSS_PER_TRADE_USD is the only
# risk budget a volume may be derived from, and MAX_SESSION_LOSS_USD / MAX_DAILY_TRADES are read
# from the persisted risk state so a restart cannot reset them. MAX_OPEN_POSITIONS=1 means no
# averaging, hedging or grid: one position at a time. MAX_LOTS_PER_POSITION caps the volume itself,
# whatever the budget would allow, and a setup above it is refused rather than resized.
MAX_OPEN_POSITIONS=1
MAX_BOT_CAPITAL_USD=3.00
MAX_LOSS_PER_TRADE_USD=0.70
MAX_SESSION_LOSS_USD=1.40
MAX_DAILY_TRADES=3
MAX_LOTS_PER_POSITION=0.01
MAX_POSITIONS_PER_SYMBOL=1
MIN_SIGNAL_SCORE=75
MAX_SPREAD_POINTS_DEFAULT=25
ORDER_DEVIATION_POINTS=10
MAGIC_NUMBER=260825
NEWS_FAIL_CLOSED=true
EMERGENCY_CLOSE_POSITIONS=false
# Strategy layer; ENABLED_STRATEGIES accepts:
# trend_following,breakout,momentum,mean_reversion,volatility,ensemble
ENABLED_STRATEGIES=trend_following
ENSEMBLE_MIN_VOTES=2
ENSEMBLE_MIN_CONFIDENCE=0.6
# Optional per-strategy timeframe overrides, e.g. STRATEGY_TIMEFRAMES=breakout:H1,momentum:M30
STRATEGY_TIMEFRAMES=
# Sizing/execution/risk guards. MAX_RISK_PER_TRADE_PCT is a hard ceiling on RISK_PER_TRADE_PCT;
# MIN_RISK_REWARD_RATIO validates take profits; exposure and margin level gate new orders.
MAX_TOTAL_EXPOSURE_PCT=200
MIN_MARGIN_LEVEL_PCT=150
MAX_RISK_PER_TRADE_PCT=2.0
MIN_RISK_REWARD_RATIO=2.0
# Runtime loop: how often the market is scanned, how many candles are fetched per timeframe
# (>=210 so EMA200 has warm-up), how long a cycle lock may be held before another process may take
# it over, and how old market data may be before the loop refuses to trade. MT5 reports *server*
# time, so raise MARKET_DATA_MAX_AGE_SECONDS if the broker's server clock is behind UTC.
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_CANDLE_COUNT=300
SCHEDULER_LOCK_TTL_SECONDS=300
MARKET_DATA_MAX_AGE_SECONDS=7200
# Reconciliation: how often MT5 history is pulled, how far back, the symbol/time/volume matching
# window used when ticket numbers cannot be matched, and how long a PENDING execution guard must
# be idle before reconciliation may retire it (only after the broker confirms no order exists).
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_LOOKBACK_HOURS=168
RECONCILIATION_MATCH_WINDOW_SECONDS=300
STALE_GUARD_SECONDS=900
# News policy. With NEWS_FAIL_CLOSED=true (the default) and no calendar configured the bot refuses
# new trades: there is no protection window to enforce, so it fails closed instead of pretending.
# Either point NEWS_EVENTS_FILE at a JSON calendar ({"time": ISO-8601, "currency": "EUR",
# "impact": "high", "title": "..."}) or set NEWS_FAIL_CLOSED=false to trade without one.
NEWS_WINDOW_MINUTES=30
NEWS_EVENTS_FILE=
# Calendar provider. NEWS_PROVIDER=trading_economics reads the official Trading Economics calendar
# API (api.tradingeconomics.com), normalises every row into this app's news-event representation and
# caches it, so the provider is never called once per symbol per cycle. The key is read from the
# environment only and is never logged. An unusable provider - missing or rejected credential,
# transport failure, unparsable payload, invalid timestamps, or a calendar older than
# NEWS_MAX_AGE_SECONDS - is reported as such, and NEWS_FAIL_CLOSED then refuses every NEW entry.
# It never closes an existing position.
NEWS_PROVIDER=static
TRADING_ECONOMICS_API_KEY=
TRADING_ECONOMICS_BASE_URL=https://api.tradingeconomics.com
NEWS_REFRESH_SECONDS=300
NEWS_MAX_AGE_SECONDS=900
NEWS_PROVIDER_TIMEOUT_SECONDS=20
NEWS_LOOKBACK_HOURS=12
NEWS_HORIZON_HOURS=168
# Unattended startup (runtime/engine_service.py, registered as the Windows task
# MT5TradingBotEngine): once the API is up, ask /api/bot/start to resume the market loop. That
# endpoint runs the full validation first - persistent risk state, PostgreSQL, MT5, the pinned
# account, the emergency lock, the session loss, the trade count and the news provider - so a
# reboot resumes trading only when every gate passes.
AUTO_START_TRADING=false
